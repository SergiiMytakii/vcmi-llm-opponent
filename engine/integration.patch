+
+// The server remains responsive during review: no sleeping thread or held game lock.
+void TurnOrderProcessor::configureTurnReview()
+{
+	const char * interval = std::getenv("VCMI_TURN_REVIEW_INTERVAL_DAYS");
+	const char * directory = std::getenv("VCMI_TURN_REVIEW_DIRECTORY");
+	const char * runId = std::getenv("VCMI_TURN_REVIEW_RUN_ID");
+	if (!interval && !directory && !runId)
+		return;
+	if (!interval || !directory || !runId)
+		throw std::runtime_error("Turn review requires interval, private control directory and run identity");
+	std::string value(interval);
+	auto parsed = std::from_chars(value.data(), value.data() + value.size(), reviewIntervalDays);
+	if (parsed.ec != std::errc() || parsed.ptr != value.data() + value.size() || reviewIntervalDays < 1 || reviewIntervalDays > 365)
+		throw std::runtime_error("Invalid turn review interval");
+	if (!std::filesystem::path(directory).is_absolute() || !std::filesystem::is_directory(directory))
+		throw std::runtime_error("Turn review requires an existing absolute private directory");
+	std::string identity(runId);
+	if (identity.size() != 32 || identity.find_first_not_of("0123456789abcdef") != std::string::npos)
+		throw std::runtime_error("Invalid turn review run identity");
+	reviewSavePrefix = "Saves/turn-review-" + identity + "-day-";
+	reviewDirectory = directory;
+	nextReviewDay = gameHandler->gameInfo().getCalendar().getCurrentDay() + reviewIntervalDays;
+	writeReviewState("running");
+}
+
+void TurnOrderProcessor::writeReviewState(const std::string & status)
+{
+	JsonNode state;
+	int day = gameHandler->gameInfo().getCalendar().getCurrentDay();
+	state["status"].String() = status;
+	state["completed_day"].Integer() = day - 1;
+	state["next_day"].Integer() = day;
+	state["interval_days"].Integer() = reviewIntervalDays;
+	state["save_resource"].String() = reviewSavePrefix + std::to_string(day - 1) + ".vsgm1";
+	std::filesystem::path destination = std::filesystem::path(reviewDirectory) / "native-state.json";
+	{
+		std::ofstream out(destination.string() + ".tmp", std::ios::trunc);
+		out.exceptions(std::ios::failbit | std::ios::badbit);
+		out << state.toCompactString() << std::endl;
+	}
+	std::filesystem::rename(destination.string() + ".tmp", destination);
+}
+
+void TurnOrderProcessor::pauseForTurnReview()
+{
+	assert(actingPlayers.empty());
+	reviewPaused = true;
+	int day = gameHandler->gameInfo().getCalendar().getCurrentDay();
+	std::string name = reviewSavePrefix + std::to_string(day - 1);
+	reviewSaveComplete = gameHandler->save(name, PlayerColor::CANNOT_DETERMINE);
+	writeReviewState(reviewSaveComplete ? "paused" : "save_failed");
+	logGlobal->info("TURN_REVIEW completed_day=%d next_day=%d saved=%d", day - 1, day, reviewSaveComplete);
+}
+
+void TurnOrderProcessor::tickTurnReview()
+{
+	if (!reviewPaused || !reviewSaveComplete)
+		return;
+	int day = gameHandler->gameInfo().getCalendar().getCurrentDay();
+	auto permit = std::filesystem::path(reviewDirectory) / ("continue-" + std::to_string(day));
+	if (!std::filesystem::exists(permit))
+		return;
+	std::filesystem::remove(permit);
+	reviewPaused = false;
+	nextReviewDay = day + reviewIntervalDays;
+	writeReviewState("running");
+	tryStartTurnsForPlayers();
+}
+
+void TurnOrderProcessor::recordReviewTurn(PlayerColor player, const std::string & phase)
+{
+	if (!reviewIntervalDays)
+		return;
+	const auto * owner = gameHandler->gameInfo().getPlayerState(player);
+	JsonNode state;
+	state["phase"].String() = phase;
+	state["day"].Integer() = gameHandler->gameInfo().getCalendar().getCurrentDay();
+	state["player"].Integer() = player.getNum();
+	state["resources"].Vector();
+	for (int i = 0; i < GameConstants::RESOURCE_QUANTITY; ++i)
+		state["resources"].Vector().emplace_back(owner->resources[GameResID(i)]);
+	state["heroes"].Vector();
+	state["towns"].Vector();
+	state["owned_objects"].Vector();
+	auto army = [](const CCreatureSet * source)
+	{
+		JsonNode result;
+		result.Vector();
+		for (const auto & [slot, stack] : source->Slots())
+		{
+			JsonNode unit;
+			unit["slot"].Integer() = slot.getNum();
+			unit["creature"].Integer() = stack->getCreatureID().getNum();
+			unit["count"].Integer() = stack->getCount();
+			result.Vector().push_back(unit);
+		}
+		return result;
+	};
+	for (const auto * hero : owner->getHeroes())
+	{
+		JsonNode item;
+		item["id"].Integer() = hero->id.getNum();
+		item["name"].String() = hero->getNameTextID();
+		item["x"].Integer() = hero->visitablePos().x;
+		item["y"].Integer() = hero->visitablePos().y;
+		item["z"].Integer() = hero->visitablePos().z;
+		item["movement"].Integer() = hero->movementPointsRemaining();
+		item["mana"].Integer() = hero->mana;
+		item["army"] = army(hero);
+		item["army_value"].Integer() = hero->estimateCombatValue();
+		state["heroes"].Vector().push_back(item);
+	}
+	for (const auto * town : owner->getTowns())
+	{
+		JsonNode item;
+		item["id"].Integer() = town->id.getNum();
+		item["name"].String() = town->getNameTextID();
+		item["army"] = army(town->getUpperArmy());
+		item["buildings"].Vector();
+		for (const auto & [id, building] : town->getTown()->buildings)
+			if (town->hasBuilt(id)) item["buildings"].Vector().emplace_back(id.getNum());
+		state["towns"].Vector().push_back(item);
+	}
+	for (const auto * object : gameHandler->gameState().getMap().getObjects())
+		if (object->getOwner() == player)
+			state["owned_objects"].Vector().emplace_back(object->id.getNum());
+	std::ofstream out(std::filesystem::path(reviewDirectory) / "turns.jsonl", std::ios::app);
+	out.exceptions(std::ios::failbit | std::ios::badbit);
+	std::string record = state.toCompactString();
+	std::erase(record, '\n');
+	std::erase(record, '\r');
+	out << record << std::endl;
+}

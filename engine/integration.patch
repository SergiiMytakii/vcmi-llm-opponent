+// The earliest scenario is deliberately conservative: enemy movement, spells,
+// artifacts and roads beyond visibility are unknown. This is not an exact ETA.
+void DangerHitMapAnalyzer::updateObservedHitMap()
+{
+    const auto size = aiNk->cc->getMapSize();
+    hitMap.resize(boost::extents[size.x][size.y][size.z]);
+    townThreats.clear();
+    enemyHeroAccessibleObjects.clear();
+    foreach_tile_pos(*aiNk->cc, [&](const int3 & pos) { hitMap[pos.x][pos.y][pos.z].reset(); });
+    for(const auto * town : aiNk->cc->getTownsInfo()) townThreats[town->id];
+    for(const auto id : aiNk->memory->visitableObjs)
+    {
+        const auto * object = aiNk->observedObject(id);
+        if(!object || object->ID != Obj::HERO || aiNk->cc->getPlayerRelations(object->getOwner(), aiNk->playerID) != PlayerRelations::ENEMIES) continue;
+        const auto * heroEnemy=dynamic_cast<const CGHeroInstance *>(object);
+        if(!heroEnemy) continue;
+        HitMapInfo threat;
+        threat.heroPtr = HeroPtr(heroEnemy, aiNk->cc.get());
+        threat.danger = aiNk->observedStrength(object);
+        threat.threat = threat.danger;
+        // Unknown arrival must not become an urgent native defense order.
+        threat.turn = std::numeric_limits<uint8_t>::max();
+        foreach_tile_pos(*aiNk->cc, [&](const int3 & pos) {
+            if(!aiNk->cc->isVisible(pos) || pos.z != object->visitablePos().z) return;
+            auto & node = hitMap[pos.x][pos.y][pos.z];
+            auto local=threat;
+            const auto from=object->visitablePos();
+            const auto * sourceTile=aiNk->cc->getTile(from), * targetTile=aiNk->cc->getTile(pos);
+            if(!heroEnemy->inBoat() && sourceTile && targetTile && sourceTile->isLand() && targetTile->isLand()
+                && from.dist2dSQ(pos)<=2 && aiNk->cc->canMoveBetween(from,pos)) local.turn=0;
+            if(local.danger > node.maximumDanger.danger) node.maximumDanger=local;
+            if(local.turn<node.fastestDanger.turn || (local.turn==node.fastestDanger.turn && local.danger>node.fastestDanger.danger)) node.fastestDanger=local;
+        });
+        for(const auto * town : aiNk->cc->getTownsInfo())
+            if(town->visitablePos().z == object->visitablePos().z) {
+                auto local=threat;
+                const auto from=object->visitablePos(),to=town->visitablePos();
+                const auto * sourceTile=aiNk->cc->getTile(from), * targetTile=aiNk->cc->getTile(to);
+                if(!heroEnemy->inBoat() && sourceTile && targetTile && sourceTile->isLand() && targetTile->isLand()
+                    && aiNk->cc->isVisible(to) && from.dist2dSQ(to)<=2 && aiNk->cc->canMoveBetween(from,to)) local.turn=0;
+                townThreats[town->id].push_back(local);
+                if(local.turn==0) enemyHeroAccessibleObjects.emplace_back(local.heroPtr.get(),town);
+            }
+    }
+    hitMapUpToDate = true;
+}

 // Getters for interfaces are separated for clarity.
+#if defined(VCMI_WINDOWS) || defined(VCMI_MAC)
+// A separate distribution can select its own writable profile without changing
+// HOME or the platform paths used by child programs (for example Codex login).
+class VCMIProfileDirs final : public IVCMIDirs
+{
+	const IVCMIDirs & platform;
+	bfs::path root;
+public:
+	VCMIProfileDirs(const IVCMIDirs & platform, bfs::path root)
+		: platform(platform), root(std::move(root))
+	{
+		if(!this->root.is_absolute())
+			throw std::invalid_argument("VCMI_PROFILE_DIR must be an absolute path");
+	}
+	bfs::path userDataPath() const override { return root; }
+	bfs::path userCachePath() const override { return root / "cache"; }
+	bfs::path userConfigPath() const override { return root / "config"; }
+	bfs::path userLogsPath() const override { return root / "logs"; }
+	bfs::path userSavePath() const override { return root / "Saves"; }
+	std::vector<bfs::path> dataPaths() const override { return platform.dataPaths(); }
+	bfs::path clientPath() const override { return platform.clientPath(); }
+	bfs::path mapEditorPath() const override { return platform.mapEditorPath(); }
+	bfs::path serverPath() const override { return platform.serverPath(); }
+	bfs::path binaryPath() const override { return platform.binaryPath(); }
+	// Base init creates only these directories; platform migrations must not
+	// inspect or move the user's installed-game profile for an explicit profile.
+};
+#endif
+

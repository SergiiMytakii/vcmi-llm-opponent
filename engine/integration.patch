 std::string CClient::aiNameForPlayer(const PlayerSettings & ps, bool battleAI, bool alliedToHuman) const
 {
+	if(!battleAI)
+	{
+		const auto & players = gameState().getStartInfo()->playerInfos;
+		const auto player = players.find(ps.color);
+		const auto & overrides = settings["session"]["playerAI"].Vector();
+		const auto index = std::distance(players.begin(), player);
+		if(player != players.end() && index < overrides.size())
+		{
+			const auto & name = overrides[index].String();
+			if(!AIFactory::isAvailableAdventureAI(name))
+				throw std::runtime_error("Unavailable per-player adventure AI: " + name);
+			return name;
+		}
+	}
 	if(ps.name.size() && AIFactory::isAvailableAdventureAI(ps.name))
 		return ps.name;
 
